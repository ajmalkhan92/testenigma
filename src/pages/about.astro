---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="About"
  description="Ajmal Khan, Quality Engineering leader with 15 years across QA, test strategy, and AI systems testing. Writes TestEnigma."
  active="about"
>
  <div class="snap-page">

    <section class="snap-sec snap-hero hero about-hero">
      <div class="wrap about-hero-grid">
        <div class="reveal">
          <img class="avatar-xl" src="/images/profile.jpg" alt="Ajmal Khan" />
        </div>
        <div class="reveal" style="--d:.08s">
          <span class="badge">QUALITY ENGINEERING LEADER</span>
          <h1 class="about-name">Hi, I&#8217;m Ajmal Khan</h1>
          <p class="sub">15 years across QA, test strategy, and now AI systems testing.</p>
          <div class="pill-row">
            <a class="btn btn-ghost" href="https://www.linkedin.com/in/ajmal-khan-98254871/" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" style="width:16px;height:16px"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.11 20.45H3.56V9h3.55z"></path></svg>
              linkedin.com/in/ajmal-khan
            </a>
            <a class="btn btn-ghost" href="https://github.com/ajmalkhan92" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" style="width:16px;height:16px"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.35.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.21.67.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"></path></svg>
              github.com/ajmalkhan92
            </a>
          </div>
        </div>
      </div>
      <div class="scroll-hint" aria-hidden="true">
        <span>Scroll</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
      </div>
    </section>

    <section class="snap-sec snap-stats band">
      <div class="wrap">
        <div class="eyebrow reveal">Track record</div>
        <div class="stat-row stat-row-center reveal">
          <div class="stat-item">
            <div class="stat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><polyline points="12 7 12 12 15 15"></polyline></svg></div>
            <div class="stat-num" data-count="15" data-suffix="+">0</div>
            <div class="stat-label">Years in QA &amp; test strategy</div>
          </div>
          <div class="stat-item" style="--d:.08s">
            <div class="stat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"></polyline><polyline points="14 7 21 7 21 14"></polyline></svg></div>
            <div class="stat-num" data-count="100" data-suffix="+">0</div>
            <div class="stat-label">Peak deploys/day shipped</div>
          </div>
          <div class="stat-item stat-item-cadence" style="--d:.16s">
            <div class="stat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></div>
            <div class="cadence-row">
              <span>3-month cycles</span>
              <span class="accent">&#8594; 100+/day</span>
            </div>
            <div class="stat-label">Release cadence, both ends</div>
          </div>
        </div>
        <p class="sub reveal" style="--d:.2s; max-width:60ch">I&#8217;ve spent 15 years in Quality Engineering across companies ranging from large MNCs to early-stage startups, which means I&#8217;ve worked both ends of the release-cadence spectrum: three-month release cycles where every change was a ceremony, and continuous deployment pipelines shipping 100+ changes to production in a day. That range is where most of what I actually know about test strategy comes from.</p>
      </div>
    </section>

    <section class="snap-sec snap-focus">
      <div class="wrap">
        <div class="eyebrow reveal">Focus areas</div>
        <div class="about-main">
          <div class="tabs reveal" role="tablist" aria-label="Focus areas">
            <button class="tab-btn on" data-tab="strategy">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="12" height="16" rx="2"></rect><polyline points="9 12 11 14 15 9"></polyline></svg>
              Test Strategy
            </button>
            <button class="tab-btn" data-tab="ai">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v4M12 17v4M3 12h4M17 12h4"></path><path d="M6 6l2.5 2.5M15.5 15.5L18 18M18 6l-2.5 2.5M8.5 15.5L6 18"></path></svg>
              AI &amp; LLM Testing
            </button>
          </div>
          <div class="tab-panel active" data-panel="strategy">
            <ul class="point-list">
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 9 17 20 6"></polyline></svg>
                <span>Turning &#8220;we shipped and nothing broke&#8221; from luck into a guarantee: deciding what needs coverage, at which layer, and what&#8217;s safe to leave untested.</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 9 17 20 6"></polyline></svg>
                <span>Contract tests at the API boundary catch what unit tests can&#8217;t: the class of bug that only shows up when two services actually talk to each other.</span>
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 12 9 17 20 6"></polyline></svg>
                <span>API and E2E testing cover different failure modes: API tests verify each service&#8217;s contract in isolation, E2E confirms the full user journey still works once those services are wired together.</span>
              </li>
            </ul>
          </div>
          <div class="tab-panel" data-panel="ai">
            <p>The newest focus: applying that same discipline (know what you&#8217;re actually verifying, test at the right layer, don&#8217;t trust a green check you can&#8217;t explain) to systems where the thing under test doesn&#8217;t return the same answer twice. Currently formalizing it through a professional certification in AI and MLOps at BITS Pilani. TestEnigma is where it gets written up.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="snap-sec snap-mission">
      <div class="wrap">
        <div class="eyebrow reveal">Mission</div>
        <p class="mission-statement reveal" style="--d:.05s">My mission is to validate whether AI is responsible and genuinely useful, through quality support at every level.</p>
        <p class="sub reveal" style="--d:.15s; max-width:60ch">I help SMB owners build and integrate AI agents into their work. Professionals and students learn to do the same, through tutorials and consulting.</p>
      </div>
    </section>

    <section class="snap-sec snap-facts">
      <div class="wrap">
        <div class="facts-grid">
          <div class="reveal">
            <div class="eyebrow">Beyond the résumé</div>
            <p>Outside of work, I&#8217;m in the gym more often than not. Same principle as testing, honestly: consistency beats intensity.</p>
            <p>Have feedback, a correction, or an idea for a post? Reach out on LinkedIn, or leave a comment on any post here.</p>
            <div class="qf-social">
              <a class="iconbtn" href="https://www.linkedin.com/in/ajmal-khan-98254871/" target="_blank" rel="noopener" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.11 20.45H3.56V9h3.55z"></path></svg>
              </a>
              <a class="iconbtn" href="https://github.com/ajmalkhan92" target="_blank" rel="noopener" aria-label="GitHub">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.75 2.69 1.25 3.35.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.21.67.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"></path></svg>
              </a>
            </div>
          </div>

          <div class="card qf-card reveal" style="--d:.1s">
            <h4>Quick facts</h4>
            <dl class="qf-list">
              <div class="qf-row"><dt>Role</dt><dd>QA &amp; AI Test Strategy Lead</dd></div>
              <div class="qf-row"><dt>Experience</dt><dd>15+ years, MNC to startup</dd></div>
              <div class="qf-row"><dt>Currently</dt><dd>AI &amp; MLOps certification, BITS Pilani</dd></div>
              <div class="qf-row"><dt>Core strength</dt><dd>Microservices, API &amp; AI test strategy</dd></div>
              <div class="qf-row"><dt>Outside work</dt><dd>Gym, most days</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  :global(html:has(.snap-page)) {
    scroll-snap-type: y proximity;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html:has(.snap-page)) {
      scroll-snap-type: none;
    }
  }
</style>

<script>
  const tabBtns = document.querySelectorAll('.about-main .tab-btn');
  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      tabBtns.forEach((b) => b.classList.remove('on'));
      btn.classList.add('on');
      document.querySelectorAll('.about-main .tab-panel').forEach((p) => p.classList.remove('active'));
      const tab = (btn as HTMLElement).dataset.tab;
      document.querySelector(`.about-main .tab-panel[data-panel="${tab}"]`)?.classList.add('active');
    });
  });

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counters = document.querySelectorAll<HTMLElement>('.stat-num');
  const animateCount = (el: HTMLElement) => {
    const target = Number(el.dataset.count || 0);
    const suffix = el.dataset.suffix || '';
    if (reduced) { el.textContent = target + suffix; return; }
    const duration = 900;
    const start = performance.now();
    const tick = (now: number) => {
      const t = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      el.textContent = Math.round(eased * target) + suffix;
      if (t < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  };
  if ('IntersectionObserver' in window && counters.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting) { animateCount(en.target as HTMLElement); io.unobserve(en.target); }
      });
    }, { threshold: 0.4 });
    counters.forEach((el) => io.observe(el));
  } else {
    counters.forEach((el) => animateCount(el));
  }

  const hint = document.querySelector<HTMLElement>('.scroll-hint');
  if (hint) {
    const updateHint = () => { hint.style.opacity = window.scrollY > 40 ? '0' : '1'; };
    updateHint();
    window.addEventListener('scroll', updateHint, { passive: true });
  }
</script>
